#!/usr/bin/env bash
# Pre-push gate: run the local mirror of CI (scripts/ci-local.sh) before anything
# leaves the machine, so a red build is caught here rather than after a PR opens.
#
# Installed by scripts/bootstrap.sh via `git config core.hooksPath .githooks`,
# so the hook is version-controlled and reviewable like the rest of the repo.
#
# Escape hatches, in order of preference:
#   git push --no-verify                     skip the gate for one push
#   PREPUSH_ARGS='--no-docker' git push      pass flags through to ci-local.sh
#   PREPUSH_SKIP=1 git push                  same as --no-verify, for scripted pushes
#
# The docker builds + both Trivy scans need a reachable docker daemon. Rather
# than fail a push on a machine without one, they're dropped automatically and
# the push is allowed — CI still runs them, which is the authoritative gate.
set -uo pipefail

if [ "${PREPUSH_SKIP:-0}" = "1" ]; then
  echo "pre-push: skipped (PREPUSH_SKIP=1)"
  exit 0
fi

# Nothing to verify when every ref being pushed is a deletion.
all_deletes=1
saw_ref=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  saw_ref=1
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] || all_deletes=0
done
if [ "$saw_ref" -eq 1 ] && [ "$all_deletes" -eq 1 ]; then
  echo "pre-push: branch deletion only — nothing to check"
  exit 0
fi

repo_root="$(git rev-parse --show-toplevel)"
gate="$repo_root/scripts/ci-local.sh"
[ -x "$gate" ] || [ -f "$gate" ] || { echo "pre-push: $gate not found — skipping"; exit 0; }

args=()
# shellcheck disable=SC2206  # deliberate word-splitting: PREPUSH_ARGS is a flag list
[ -n "${PREPUSH_ARGS:-}" ] && args+=($PREPUSH_ARGS)

if ! docker info >/dev/null 2>&1; then
  case " ${args[*]-} " in
    *" --no-docker "*) ;;
    *) echo "pre-push: docker unreachable — running without the image builds/Trivy (CI still runs them)"
       args+=(--no-docker) ;;
  esac
fi

echo "pre-push: running scripts/ci-local.sh ${args[*]-}"
if bash "$gate" "${args[@]}"; then
  exit 0
fi

cat >&2 <<'MSG'

pre-push: the local CI gate FAILED — push aborted.
Fix the failing step above, or push anyway with:  git push --no-verify
MSG
exit 1
